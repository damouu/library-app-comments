{
  "name": "library-app-comments",
  "version": "2.0.0",
  "type": "module",
  "description": "Distributed Library System — Comments Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import tsx --import ./src/instrumentation.ts --watch --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "debug": "node --inspect=0.0.0.0:9229 dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "complexity": "eslint \"src/**/*.ts\" --rule 'complexity: [\"warn\", {\"max\": 0}]' --rule 'sonarjs/cognitive-complexity: [\"warn\", 0]'",
    "prepare": "husky",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "private": true,
  "author": "damouu",
  "license": "ISC",
  "dependencies": {
    "@jest/globals": "^30.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.31.0",
    "@opentelemetry/instrumentation-mongodb": "^0.75.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.0.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
